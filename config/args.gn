# Stable SOURCE, not an official Google Chrome release build.
target_os = "android"
target_cpu = "arm64"
is_debug = false
is_component_build = false
is_official_build = false
is_chrome_branded = false
android_channel = "default"

# Keep the build local and checkpoint-compatible.
use_remoteexec = false
use_siso = false
android_static_analysis = "off"  # official builds use "off"; saves lint/ErrorProne time

# Standard-hosted runner resource compromises, NOT security-feature switches.
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
chrome_pgo_phase = 0
use_thin_lto = false
